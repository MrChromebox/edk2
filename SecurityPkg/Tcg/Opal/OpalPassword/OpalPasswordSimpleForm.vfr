#include "OpalHiiFormValues.h"
#include <Guid/TcgUiConfig.h>

#define EFI_HII_PLATFORM_SETUP_FORMSET_GUID \
  { 0x93039971, 0x8545, 0x4b04, { 0xb4, 0x5e, 0x32, 0xeb, 0x83, 0x26, 0x4, 0xe } }

formset
  guid      = SETUP_FORMSET_GUID,
  title     = STRING_TOKEN(STR_SIMPLE_DISK_PROTECTION),
  help      = STRING_TOKEN(STR_SIMPLE_FORM_SET_HELP),
  classguid = EFI_HII_PLATFORM_SETUP_FORMSET_GUID,

  // Define a Buffer Storage (EFI_IFR_VARSTORE) that will be filled
  // out initially through extractConfig call
  varstore OPAL_HII_CONFIGURATION,           // This is the Data structure type
    name  = OpalHiiConfig,                   // Define referenced name in vfr
    guid  = SETUP_VARIABLE_GUID;             // GUID of this Buffer storage

  efivarstore TCG_UI_CONFIG_VARSTORE_DATA,
    attribute = 0x03,  // EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_NON_VOLATILE
    name  = TcgUiConfig,
    guid  = TCG_UI_CONFIG_FORMSET_GUID;

form formid = FORMID_VALUE_MAIN_MENU,
    title  = STRING_TOKEN(STR_SIMPLE_DISK_PROTECTION);

    subtitle text = STRING_TOKEN(STR_NULL);

    oneof varid = TcgUiConfig.TcgStorageUiMode,
      prompt = STRING_TOKEN(STR_TCG_STORAGE_UI_MODE_PROMPT),
      help   = STRING_TOKEN(STR_TCG_STORAGE_UI_MODE_HELP),
      flags  = NUMERIC_SIZE_1 | RESET_REQUIRED,
      option text = STRING_TOKEN(STR_TCG_UI_MODE_ADVANCED), value = 0, flags = DEFAULT | MANUFACTURING;
      option text = STRING_TOKEN(STR_TCG_UI_MODE_STANDARD), value = 1, flags = 0;
    endoneof;

    subtitle text = STRING_TOKEN(STR_NULL);

    suppressif TRUE;
        label OPAL_MAIN_MENU_LABEL_START;
        label OPAL_MAIN_MENU_LABEL_END;

        numeric
            name    = SupportedDisks,
            varid   = OpalHiiConfig.SupportedDisks,
            prompt  = STRING_TOKEN(STR_NULL),
            help    = STRING_TOKEN(STR_NULL),
            flags   = INTERACTIVE,
            key     = 0x8002,
            minimum = 0x0,
            maximum = 0xFFFF,
        endnumeric;
    endif;

    subtitle text = STRING_TOKEN(STR_SIMPLE_MAIN_TITLE_LBL);

    subtitle text = STRING_TOKEN(STR_NULL);

    subtitle text = STRING_TOKEN(STR_MAIN_PHY_DISKS_LBL);

    //DISK( 0 );
    suppressif ( questionref(SupportedDisks) & ( 0x1 ) ) == 0;
        goto FORMID_VALUE_DISK_INFO_FORM_MAIN,
            prompt  = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_0 ),
            help    = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_HELP),
            flags   = INTERACTIVE,
            key     = 0x8001;
    endif;

    //DISK( 1 );
    suppressif ( questionref(SupportedDisks) & ( 0x2 ) ) == 0;
        goto FORMID_VALUE_DISK_INFO_FORM_MAIN,
            prompt  = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_1 ),
            help    = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_HELP),
            flags   = INTERACTIVE,
            key     = 0x8101;
    endif;

    //DISK( 2 );
    suppressif ( questionref(SupportedDisks) & ( 0x4 ) ) == 0;
        goto FORMID_VALUE_DISK_INFO_FORM_MAIN,
            prompt  = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_2 ),
            help    = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_HELP),
            flags   = INTERACTIVE,
            key     = 0x8201;
    endif;

    //DISK( 3 );
    suppressif ( questionref(SupportedDisks) & ( 0x8 ) ) == 0;
        goto FORMID_VALUE_DISK_INFO_FORM_MAIN,
            prompt  = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_3 ),
            help    = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_HELP),
            flags   = INTERACTIVE,
            key     = 0x8301;
    endif;

    //DISK( 4 );
    suppressif ( questionref(SupportedDisks) & ( 0x10 ) ) == 0;
        goto FORMID_VALUE_DISK_INFO_FORM_MAIN,
            prompt  = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_4 ),
            help    = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_HELP),
            flags   = INTERACTIVE,
            key     = 0x8401;
    endif;

    //DISK( 5 );
    suppressif ( questionref(SupportedDisks) & ( 0x20 ) ) == 0;
        goto FORMID_VALUE_DISK_INFO_FORM_MAIN,
            prompt  = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_5 ),
            help    = STRING_TOKEN(STR_MAIN_GOTO_DISK_INFO_HELP),
            flags   = INTERACTIVE,
            key     = 0x8501;
    endif;

    //No disks on system
    suppressif ideqval OpalHiiConfig.NumDisks > 0;
        text
            help    = STRING_TOKEN(STR_MAIN_NO_DISKS_PRESENT_LBL_HELP),
            text    = STRING_TOKEN(STR_MAIN_NO_DISKS_PRESENT_LBL);
    endif;

endform;  // MAIN MENU FORM

//
/////////////////   DISK INFO FORM   /////////////////
//
form formid = FORMID_VALUE_DISK_INFO_FORM_MAIN,
    title  = STRING_TOKEN(STR_SIMPLE_DISK_PROTECTION);

    suppressif TRUE;
        label OPAL_DISK_INFO_LABEL_START;
        label OPAL_DISK_INFO_LABEL_END;

        numeric
            name    = SelectedDiskAvailableActions,
            varid   = OpalHiiConfig.SelectedDiskAvailableActions,
            prompt  = STRING_TOKEN(STR_NULL),
            help    = STRING_TOKEN(STR_NULL),
            flags   = INTERACTIVE,
            key     = 0x8003,
            minimum = 0x0,
            maximum = 0xFFFF,
        endnumeric;
    endif;

    subtitle text = STRING_TOKEN(STR_SIMPLE_DISK_INFO_TITLE_LBL);

    subtitle text = STRING_TOKEN(STR_NULL);

    subtitle text = STRING_TOKEN(STR_DISK_INFO_SELECTED_DISK_NAME);

    subtitle text = STRING_TOKEN(STR_NULL);

    subtitle text = STRING_TOKEN(STR_SIMPLE_ACTIONS_LBL);

    //
    // Set Disk Admin Password (initial enable/ownership)
    //
    suppressif ( questionref(SelectedDiskAvailableActions) & HII_ACTION_ENABLE_FEATURE ) == 0;
        text
            help    = STRING_TOKEN(STR_SIMPLE_SET_DISK_ADMIN_PASSWORD_HELP),
            text    = STRING_TOKEN(STR_SIMPLE_SET_DISK_ADMIN_PASSWORD),
            flags   = INTERACTIVE,
            key     = 0x800C;
    endif;

    //
    // Change Disk Admin Password
    //
    suppressif ( questionref(SelectedDiskAvailableActions) & HII_ACTION_SET_ADMIN_PWD ) == 0;
        text
            help    = STRING_TOKEN(STR_SIMPLE_CHANGE_DISK_ADMIN_PASSWORD_HELP),
            text    = STRING_TOKEN(STR_SIMPLE_CHANGE_DISK_ADMIN_PASSWORD),
            flags   = INTERACTIVE,
            key     = 0x8005;
    endif;

    //
    // Disable/Remove Disk Admin Password (non-destructive; requires current password)
    //
    suppressif ( questionref(SelectedDiskAvailableActions) & HII_ACTION_REVERT ) == 0;
        text
            help    = STRING_TOKEN(STR_SIMPLE_DISABLE_DISK_ADMIN_PASSWORD_HELP),
            text    = STRING_TOKEN(STR_SIMPLE_DISABLE_DISK_ADMIN_PASSWORD),
            flags   = INTERACTIVE,
            key     = 0x8008;
    endif;

    //
    // Erase & Reset (Forgotten Password) (destructive; does not require current password)
    //
    suppressif ( questionref(SelectedDiskAvailableActions) & HII_ACTION_PSID_REVERT ) == 0;
        text
            help    = STRING_TOKEN(STR_SIMPLE_ERASE_AND_RESET_HELP),
            text    = STRING_TOKEN(STR_SIMPLE_ERASE_AND_RESET),
            flags   = INTERACTIVE,
            key     = 0x800A;
    endif;

endform;  // DISK INFO FORM

endformset;
