#string STR_BOOT_SPLASH_ENABLE_HELP         #language en-US "Enable or disable displaying a logo during boot"

#string STR_BOOT_SPLASH_TYPE_PROMPT         #language en-US "Logo source"
#string STR_BOOT_SPLASH_TYPE_HELP           #language en-US "Use the built-in logo or a custom BMP copied to the EFI System Partition"
