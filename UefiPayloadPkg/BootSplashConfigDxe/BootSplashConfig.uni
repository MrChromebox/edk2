#string STR_BOOT_SPLASH_FORMSET_HELP        #language en-US "Configure the boot splash logo"

#string STR_BOOT_SPLASH_FORM_TITLE          #language en-US "Boot Splash"
#string STR_BOOT_SPLASH_FORM_SUBTITLE       #language en-US "Boot splash logo options:"

